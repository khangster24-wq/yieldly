# Yieldly environment variables — copy to .env.local and fill in.
# .env.local is gitignored; never commit real keys.

# College Scorecard API (free key from https://api.data.gov/signup)
# Used by `npm run data:colleges` to pull the real college dataset.
SCORECARD_API_KEY=

# Gemini API key (for the Phase 4 AI College Counselor) — free tier.
# Get one at https://aistudio.google.com/apikey — read at runtime, never hardcoded.
GEMINI_API_KEY=
